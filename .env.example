DATABASE_URL=postgres://sabf:sabf@localhost:5432/sabf

# Host/port the HTTP server binds to
HOST=0.0.0.0
PORT=8080

# HS256 signing secret for access tokens. MUST be at least 32 bytes of
# high-entropy randomness — generate your own, e.g. `openssl rand -base64 48`.
# The server refuses to start if this is set but shorter than 32 bytes. If left
# unset, a random secret is generated at process start (existing tokens become
# invalid on every restart). Never reuse this example value.
JWT_SECRET=

# Access token lifetime, in seconds (~15 min per spec).
ACCESS_TOKEN_TTL_SECS=900

# Refresh token lifetime, in seconds (~30 days per spec).
REFRESH_TOKEN_TTL_SECS=2592000

# Login rate limiting: max attempts per rolling window, keyed by username and by IP.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECS=60

# When the server runs behind a reverse proxy, set this to the header the proxy
# uses to convey the real client IP (e.g. X-Forwarded-For) so per-IP login rate
# limiting keys on the client rather than the proxy. Leave unset when the server
# is directly exposed — a client-supplied header would otherwise be spoofable.
# CLIENT_IP_HEADER=X-Forwarded-For

# CORS: allowed frontend origins. Either "*" (any origin) or a comma-separated
# list of exact origins, e.g. "https://app.example.com,https://staging.example.com".
# If unset, no cross-origin requests are allowed.
CORS_ALLOWED_ORIGINS=*
