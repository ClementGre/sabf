DATABASE_URL=postgres://sabf:sabf@localhost:5432/sabf

# Host/port the HTTP server binds to
HOST=0.0.0.0
PORT=8080

# HS256 signing secret for access tokens. If unset, a random secret is
# generated at process start (existing tokens become invalid on restart).
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime, in seconds (~15 min per spec).
ACCESS_TOKEN_TTL_SECS=900

# Refresh token lifetime, in seconds (~30 days per spec).
REFRESH_TOKEN_TTL_SECS=2592000

# Login rate limiting: max attempts per rolling window, keyed by username and by IP.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECS=60

# CORS: allowed frontend origins. Either "*" (any origin) or a comma-separated
# list of exact origins, e.g. "https://app.example.com,https://staging.example.com".
# If unset, no cross-origin requests are allowed.
CORS_ALLOWED_ORIGINS=*
