  "query": "\n        SELECT aa.app_id, a.slug, aa.role, aa.created_at\n        FROM apps_access aa\n        JOIN apps a ON a.id = aa.app_id\n        WHERE aa.user_id = $1 AND aa.status = 'pending'\n        ORDER BY aa.created_at\n        ",
