  "query": "\n        SELECT a.id AS app_id, a.slug, a.encrypted_metadata,\n               aa.role, aa.status, aa.wrapped_dek, aa.last_edit_at\n        FROM apps_access aa\n        JOIN apps a ON a.id = aa.app_id\n        WHERE aa.app_id = $1 AND aa.user_id = $2\n        ",
